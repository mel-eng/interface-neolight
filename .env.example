# =========================================================
# NEOLIGHT — variables de entorno del servidor
# Uso local: copiar a .env y ajustar.
# En Railway NO se sube este archivo: las variables se cargan
# en la pestaña "Variables" del servicio (ver DESPLIEGUE_RAILWAY.md).
# =========================================================

PORT=3000

# ---------- Base de datos MySQL ----------
# Opción A (local): variables sueltas
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lampara

# Opción B (Railway): una sola dirección. Si existe, tiene prioridad sobre la opción A.
# MYSQL_URL=mysql://usuario:clave@host:3306/base

# Zona horaria de las fechas y horas guardadas (por defecto America/La_Paz)
# TZ=America/La_Paz

# CORS — origen permitido (* para desarrollo)
CORS_ORIGIN=*

# Código de acceso hospitalario (cámbialo en la nube)
HOSPITAL_CODE=152436

# Clave que la lámpara envía al servidor (cabecera x-device-key).
# En la nube es obligatoria: sin ella cualquiera podría enviar datos falsos.
# DEVICE_KEY=una-clave-larga-que-solo-conozca-el-equipo

# ---------- ESP32 ----------
# Solo para uso local, cuando la computadora está en la red NEOLIGHT.
# En la nube se deja vacío: el servidor no puede alcanzar 192.168.4.1.
ESP32_MASTER_URL=http://192.168.4.1
CAMERA_STREAM_URL=http://192.168.4.50/stream

# --- Superusuario ---
# El servidor crea (o actualiza) esta cuenta al arrancar. No la escribas en el código:
# en Railway va en la pestaña Variables.
# SUPERUSER_USER=mel
# SUPERUSER_PASS=cambia-esto
# Código de 6 dígitos que se pide después. Si no lo pones, se usa HOSPITAL_CODE.
# SUPERUSER_CODE=152436
# Segundos que dura el acceso técnico abierto desde el panel de la lámpara.
# TECH_WINDOW_S=120

# --- Saludo con voz (ElevenLabs) ---
# Sin estas dos variables el saludo igual suena, pero con la voz del navegador.
# ELEVENLABS_API_KEY=tu-clave-de-elevenlabs
# ELEVENLABS_VOICE_ID=id-de-la-voz-que-elijas
# ELEVENLABS_MODEL=eleven_multilingual_v2
